// cec-bridge enclosure — parametric OpenSCAD source.  Units: mm.
//
// Geometry is written in BOARD coordinates (x right, y DOWN from the board's top edge, z up) so
// every number matches BRIEF.md; to_model() mirrors Y once at the end into the STL/model frame
// (model Y = -board y).  z = 0 is the underside of the base.
//
// Build:  openscad -o base.stl -D 'part="base_print"' enclosure.scad
//         openscad -o lid.stl  -D 'part="lid_print"'  enclosure.scad
//         ./make_outputs.sh   (STLs + PNG previews + keep-out checks)
//
// !! Values marked PENDING are waiting for caliper readings (BRIEF "Measure first"). !!

include <board_keepouts.scad>   // generated by keepouts_from_stl.py

/* [Render] */
part          = "assembly";  // assembly | base | lid | base_print | lid_print | section_hdmi | section_antenna | section_hook | top_antenna | lid_keepout_check | base_keepout_check | base_lid_overlap_check | insertion_check | test_hook_base | test_hook_lid | test_h2_hook_base | test_h2_hook_lid
show_ghost    = true;        // board STL as a % ghost
show_keepouts = true;        // coloured keep-out boxes (incl. the parts with no model)
lid_lift      = 0;           // explode the lid upward in "assembly"
lid_x_shift   = 0;           // X offset on lid in base_lid_overlap_check / insertion_check
lid_z_shift   = 0;           // Z offset on lid in base_lid_overlap_check / insertion_check (test with -1)
ghost_stl     = "board-model/cec-bridge-assembled.stl";

/* [Measure first — caliper readings] */
hdmi_h     = 6.3;   // measured: 7.9 mm from board bottom - 1.6 mm PCB = 6.3 mm above board top
hdmi_leg   = 0.8;   // measured ~0.7 mm below board bottom (+0.1 mm margin; shifted model: 0.72)
usb_h      = 3.4;   // measured: 5.0 mm from board bottom - 1.6 mm PCB = 3.4 mm above board top
jst_h      = 5.7;   // measured: 7.3 mm from board bottom - 1.6 mm PCB = 5.7 mm above board top
u4_lens_up = true;  // measured: dome perpendicular to board plane (+Z, top-view IRM-H638T)
hdmi_mould_w = 20.0; // plug overmould opening width  (assumed cable; adjust to your actual plug)
hdmi_mould_h = 10.0; // plug overmould opening height (assumed cable; adjust to your actual plug)

/* [General] */
clr        = 0.3;   // clearance per side, board/parts to case
wall       = 1.6;
floor_t    = 2.0;
lid_t      = 1.6;
standoff_h = 3.0;   // floor top -> board underside
split_above_board = 1.0;  // base wall top, above board top
lap_h      = 1.5;   // lid/base half-lap height
lap_clr    = 0.15;  // half-lap clearance
$fn        = 48;

/* [Board] */
board_w = 40;  board_l = 48;  board_t = 1.6;  board_r = 2.5;
h1 = [21.5, 22.8];          // M2 mounting holes (2.2 mm)
h2 = [37.5, 30.5];

/* [Antenna (U1 PCB antenna overhang)] */
ant_x0 = 5;  ant_x1 = 23;
ant_overhang = 6.3;         // past the top edge (board y 0 -> -6.3)
ant_h   = 0.83;             // antenna PCB top above board top (model)
ant_air = 1.5;              // >= 1 mm air required
ant_metal_keepout = 10;     // no metal within this distance

/* [J2 HDMI — positions from the board's drill slots; the supplier model is off by +7.25 y, +2.91 z] */
hdmi_x0 = 2.5;  hdmi_x1 = 17.5;  hdmi_cx = 10;
hdmi_face_y  = 47.65;       // socket face (0.35 behind the edge)
hdmi_rear_y  = 36.55;       // rear face of the housing + pins (model shifted +7.25 y)
hdmi_lead_y0 = 36.5;
hdmi_mouth_zc = hdmi_h / 2; // mouth centre above board top (assumed mid-height)
hdmi_slots = [[2.75, 36.43, 39.13], [2.75, 42.73, 44.83],   // [x, y0, y1] PTH slots, 0.9 wide
              [17.25, 36.43, 39.13], [17.25, 42.73, 44.83]];
hdmi_pocket_margin = 1.0;   // relief pocket margin around the leg slots
hdmi_top_gap = 0.05;        // lid underside -> housing top
rib_t     = 2.5;            // backing rib thickness (y)
rib_gap   = 0.15;           // rib -> housing rear face
rib_clear = 1.7;            // rib underside above board top (clears 1.54 mm part behind J2)

/* [J1 USB-C] */
usb_cx = 32.0;  usb_w = 8.94;  usb_d = 7.3;  usb_proud = 0.46;
usb_open_w = 12.5;  usb_open_h = 7.0;

/* [J3 JST-PH 2-pin, mouth to the right edge] */
jst_cy = 21.0;  jst_w = 8.0;  jst_d = 7.9;
jst_mouth_x = 40.0;         // assumed flush with the edge
jst_plus = [37.0, 26.5];    // "+" mark on pin-1 side (y = 22, toward USB end)
mark_depth = 0.6;

/* [Tactiles] */
sw_size = 5.1;  sw_h = 1.5;
sw1 = [5.7, 18.8];  sw2 = [14.6, 18.8];

/* [Lid apertures: [x, y, hole d, tube bottom above board top, label]] */
tube_wall = 1.0;
apertures = [
  [36.5, 10.0, 5.0, 1.2,  "D2"],    // IR LED 940 nm, open hole (0.5 tall LED, 0.79 part at tube edge)
  [31.5,  3.2, 4.5, 4.34, "U4"],    // IR receiver dome lens centred (31.5, 3.2), body 4.04 tall
  [26.5, 17.2, 2.0, 1.4,  "D3"],    // status LED (1.09 tall)
  [ 5.7, 18.8, 1.6, 2.0,  "SW1"],   // RESET pinhole + guide
  [14.6, 18.8, 1.6, 2.0,  "SW2"],   // BOOT pinhole + guide
];
pin_recess_d = 3.6;  pin_recess = 1.5;  // pinholes recessed ~1.5 mm
d2_window_recess = 0;  // >0: counterbore this deep for a thin IR-transparent insert over D2
d2_window_d = 8;

/* [Fasteners: two M3 x 8 mm SHCS on left side only + right-side hook tabs] */
standoff_d  = 5.5;
pin_d       = 2.0;  pin_h = 1.4;      // printed PCB locating pins at H1/H2 (no metal near PCB)
support_d   = 4.0;
supports    = [[3, 3], [37, 3], [3, 32], [23.5, 46]];  // extra flat-support posts
post_d      = 5.0;  // solid plastic lid clamp post at H1 (no metal near H1 3V3 track)
h2_post_pos = [36.6, 30.5];  h2_post_d = 4.0; // beside H2 (right edge x=38.6 <= 38.7; clears right wall during +1.4 X-slide)
ant_lap_base = [5.5, 35.5];  // straight antenna half-lap tongue X span on base (1.5-2.0 mm inset from lid pocket for X-slide relief)
ant_lap_lid  = [3.5, 37.0];  // straight antenna half-lap pocket X span on lid
lugs        = [[-5.5, 10.0], [-5.5, 38.0]]; // left-side (connector-free) M3 lugs, >=10 mm from antenna
lug_d       = 10.0;
hooks       = [[6.0, 12.0], [33.0, 40.0]];  // [y0, y1] right-side base windows / lid hook tabs (clear of J3)
hook_clr    = 0.3;  hook_stem_clr = 0.2;  hook_stem_t = 1.1;  hook_catch_in = 1.2; // stem outside wall; catch reaches 1.2 mm inward (0.7 mm clear of PCB)
hook_z0     = 3.8;  hook_z1 = 5.6;  hook_chamfer_z = 4.2; // 45-deg ramp (5.6 -> 4.2) prints support-free
hook_win_z0 = 3.6;  hook_win_z1 = 5.8;
bolt_l      = 8.0;  // M3 x 8 mm socket head cap screw
screw_clear_d = 3.4;
head_d      = 6.0;  head_cbore = 3.2; // DIN 912 M3 cap head (5.5 dia x 3.0 h), recessed flush
use_inserts = true; // M3 x 5.7 x 4.6 (measured OD 4.54, H 5.7) heat-set inserts in base lugs
insert_hole_d = 4.0;  insert_l = 5.7;  insert_chamfer = 0.6;  insert_relief = 0.6;
pilot_d     = 2.6;  // M3 self-tap fallback if use_inserts = false

/* [Keyholes] */
keyholes   = [[9, 23], [31, 23]];  // head-entry centres; slot runs toward the antenna end (-y)
kh_head_d  = 8.2;  kh_slot_w = 4.2;  kh_slot_l = 6.0;
kh_lip     = 1.2;  kh_cavity = 2.2;  kh_roof = 0.8;  kh_pad_margin = 1.6;

// ---------------- derived ----------------
z_bb    = floor_t + standoff_h;          // board bottom
z_bt    = z_bb + board_t;                // board top
z_split = z_bt + split_above_board;
tallest = max(hdmi_h, jst_h, usb_h, 4.04, 3.19);
z_ceil  = z_bt + tallest + hdmi_top_gap; // lid underside
z_top   = z_ceil + lid_t;
cav = [-clr, -ant_overhang - ant_air, board_w + clr, board_l + clr];  // x0 y0 x1 y1
r_in = board_r + clr;
usb_y1 = board_l + usb_proud;  usb_y0 = usb_y1 - usb_d;
jst_x0 = jst_mouth_x - jst_d;
kh_t = kh_lip + kh_cavity + kh_roof;
bolt_tip = z_top - head_cbore - bolt_l;
insert_z0 = z_split - insert_l;
insert_pocket_z0 = z_split - insert_l - insert_relief;

// distance from point to antenna rectangle (board xy)
function ant_dist(p) = let(dx = max(ant_x0 - p[0], 0, p[0] - ant_x1),
                           dy = max(-ant_overhang - p[1], 0, p[1] - 0)) sqrt(dx*dx + dy*dy);

x_min_outer = min(cav[0] - wall, min([for (p = lugs) p[0] - lug_d/2]));
x_max_outer = cav[2] + wall + hook_stem_clr + hook_stem_t;
echo(str("OUTER mm: ", cav[2]-cav[0]+2*wall, " x ", cav[3]-cav[1]+2*wall, " x ", z_top,
         " (with lugs + hook stems: ", x_max_outer - x_min_outer, " mm wide)"));
echo(str("Z: board bottom ", z_bb, ", top ", z_bt, ", split ", z_split, ", lid underside ", z_ceil));
echo(str("HDMI leg tip z ", z_bb - hdmi_leg, " (floor top ", floor_t, ")"));
echo(str("Bolt M3x", bolt_l, ": head seat z ", z_top - head_cbore, ", tip z ", bolt_tip,
         ", insert z ", insert_z0, "-", z_split, ", engagement ", z_split - bolt_tip));
for (p = concat(lugs, keyholes, [for (k = keyholes) [k[0], k[1] - kh_slot_l]]))
  echo(str("metal at ", p, ": ", ant_dist(p) - max(head_d, kh_head_d)/2, " mm (worst case) from antenna"));
assert(min([for (p = lugs) ant_dist(p) - head_d/2]) >= ant_metal_keepout, "M3 lug metal too close to antenna");
assert(min([for (k = keyholes) ant_dist([k[0], k[1] - kh_slot_l]) - kh_head_d/2]) >= ant_metal_keepout, "keyhole metal too close to antenna");
assert(kh_t <= z_bb - 0.5, "keyhole pad hits the board underside");
assert(insert_pocket_z0 >= 1.0, "insert pocket too close to base bottom");
assert(bolt_tip >= insert_z0 + 0.5, "M3 bolt bottoms out in insert");

// ---------------- helpers ----------------
module rr2d(b, r) { translate([b[0], b[1]]) offset(r) offset(-r) square([b[2]-b[0], b[3]-b[1]]); }
module rbox(b, r, z0, z1) { translate([0, 0, z0]) linear_extrude(z1 - z0) rr2d(b, r); }
function grow(b, d) = [b[0]-d, b[1]-d, b[2]+d, b[3]+d];
module box(x0, y0, z0, x1, y1, z1) { translate([x0, y0, z0]) cube([x1-x0, y1-y0, z1-z0]); }
module ring(b_in, r, d_in, d_out, z0, z1)
  difference() { rbox(grow(b_in, d_out), r + d_out, z0, z1); rbox(grow(b_in, d_in), r + d_in, z0 - 1, z1 + 1); }
module to_model() mirror([0, 1, 0]) children();
module mtext(t, s) mirror([0, 1, 0]) text(t, size = s, halign = "center", valign = "center", font = "Liberation Sans:style=Bold");

// ---------------- cut-outs shared by base and lid ----------------
module openings() {
  // HDMI: plug overmould must reach within ~1 mm of the socket face -> cut the wall to the moulding
  box(hdmi_cx - hdmi_mould_w/2, cav[3] - 0.01, z_bt + hdmi_mouth_zc - hdmi_mould_h/2,
      hdmi_cx + hdmi_mould_w/2, cav[3] + wall + 1, z_bt + hdmi_mouth_zc + hdmi_mould_h/2);
  // USB-C overmould
  box(usb_cx - usb_open_w/2, cav[3] - 0.01, z_bt + usb_h/2 - usb_open_h/2,
      usb_cx + usb_open_w/2, cav[3] + wall + 1, z_bt + usb_h/2 + usb_open_h/2);
  // JST mouth (open from the board top up)
  box(cav[2] - 0.01, jst_cy - jst_w/2 - clr, z_bt - 0.01,
      cav[2] + wall + 1, jst_cy + jst_w/2 + clr, z_bt + jst_h + clr);
}

// ---------------- base ----------------
module base() {
  difference() {
    union() {
      rbox(grow(cav, wall), r_in + wall, 0, floor_t);                    // floor
      ring(cav, r_in, 0, wall, floor_t - 0.01, z_split);                 // walls
      // inner half-lap tongue along straight antenna wall only (inset from lid pocket for 1.4 mm X-slide clearance)
      intersection() {
        ring(cav, r_in, 0, wall/2 - lap_clr/2, z_split - 0.01, z_split + lap_h);
        box(ant_lap_base[0], cav[1] - wall - 1, z_split - 0.1, ant_lap_base[1], 0, z_split + lap_h + 1);
      }
      for (p = [h1, h2]) translate([p[0], p[1], floor_t - 0.01]) {
        cylinder(d = standoff_d, h = standoff_h + 0.01);
        translate([0, 0, standoff_h]) {
          cylinder(d = pin_d, h = pin_h - 0.4 + 0.01);
          translate([0, 0, pin_h - 0.4]) cylinder(d1 = pin_d, d2 = pin_d - 0.6, h = 0.4);
        }
      }
      for (p = supports) translate([p[0], p[1], floor_t - 0.01]) cylinder(d = support_d, h = standoff_h + 0.01);
      // external side-ear lugs for M3 x 5.7 x 4.6 inserts (flared to outer wall, flush at inner wall)
      difference() {
        for (p = lugs) hull() {
          translate([p[0], p[1], 0]) cylinder(d = lug_d, h = z_split);
          translate([p[0] < 0 ? cav[0] - wall/2 : cav[2] + wall/2, p[1], 0]) cylinder(d = lug_d, h = z_split);
        }
        rbox(cav, r_in, -1, z_split + 1);
      }
      // top-edge stops: blocks from the back wall to the board's top edge, either side of the antenna
      // (with the HDMI backing these take the plug-insertion load into the case, not the pins)
      intersection() {
        rbox(cav, r_in, floor_t - 0.01, z_split);
        union() {
          box(cav[0] - 0.01, cav[1] - 0.01, floor_t - 0.01, ant_x0 - ant_air, -clr, z_split);
          box(ant_x1 + ant_air, cav[1] - 0.01, floor_t - 0.01, cav[2] + 0.01, -clr, z_split);
        }
      }
      // keyhole pads
      for (k = keyholes)
        rbox([k[0] - kh_head_d/2 - kh_pad_margin, k[1] - kh_slot_l - kh_head_d/2 - kh_pad_margin,
              k[0] + kh_head_d/2 + kh_pad_margin, k[1] + kh_head_d/2 + kh_pad_margin], 2.0, 0, kh_t);
    }
    openings();
    // right-side hook windows (3.6..5.8 mm Z through 1.6 mm wall, leaving 1.8 mm solid lintel above)
    for (h = hooks)
      box(cav[2] - 0.1, h[0], hook_win_z0, cav[2] + wall + 0.1, h[1], hook_win_z1);
    // M3 insert pockets (or pilot holes) in the base lugs
    for (p = lugs) translate([p[0], p[1], 0]) {
      if (use_inserts) {
        translate([0, 0, insert_pocket_z0]) cylinder(d = insert_hole_d, h = z_split - insert_pocket_z0 + 1);
        translate([0, 0, z_split - insert_chamfer]) cylinder(d1 = insert_hole_d, d2 = 4.6, h = insert_chamfer + 0.5);
      } else {
        translate([0, 0, insert_pocket_z0]) cylinder(d = pilot_d, h = z_split - insert_pocket_z0 + 1);
      }
    }
    // HDMI shell-leg relief pockets (only if the legs reach below floor-top + 0.5)
    leg_floor = z_bb - hdmi_leg - 0.5;
    if (leg_floor < floor_t)
      for (s = hdmi_slots)
        box(s[0] - 0.45 - hdmi_pocket_margin, s[1] - hdmi_pocket_margin, max(leg_floor, 0.6),
            s[0] + 0.45 + hdmi_pocket_margin, s[2] + hdmi_pocket_margin, floor_t + 1);
    // keyholes: narrow lips at the bottom, rectangular head channel above (straight bridge), roof on top
    for (k = keyholes) translate([k[0], k[1], 0]) {
      translate([0, 0, -1]) cylinder(d = kh_head_d, h = kh_lip + kh_cavity + 1);
      hull() for (dy = [0, -kh_slot_l]) translate([0, dy, -1]) cylinder(d = kh_slot_w, h = kh_lip + 1.01);
      box(-kh_head_d/2, -kh_slot_l - kh_head_d/2, kh_lip, kh_head_d/2, 0, kh_lip + kh_cavity);
    }
  }
}

// ---------------- lid ----------------
module lid() {
  difference() {
    union() {
      rbox(grow(cav, wall), r_in + wall, z_ceil, z_top);                                  // top plate
      ring(cav, r_in, 0, wall, z_split + lap_h + lap_clr, z_ceil + 0.01);                // full skirt
      // outer half-lap on straight antenna wall only; flat skirt at z_split + 0.15 elsewhere for X-slide
      intersection() {
        ring(cav, r_in, wall/2 + lap_clr/2, wall, z_split, z_split + lap_h + lap_clr + 0.01);
        box(ant_lap_lid[0], cav[1] - wall - 1, z_split - 0.1, ant_lap_lid[1], 0, z_split + lap_h + lap_clr + 0.1);
      }
      difference() {
        ring(cav, r_in, 0, wall, z_split + 0.15, z_split + lap_h + lap_clr + 0.01);
        box(ant_lap_lid[0], cav[1] - wall - 1, z_split, ant_lap_lid[1], 0, z_split + lap_h + lap_clr + 0.1);
      }
      // right-side hook tabs: stem OUTSIDE base wall (x=42.1..43.2), catch reaches INWARD (x=40.7..43.2)
      x_catch  = cav[2] + wall - hook_catch_in;       // 40.7 (0.7 mm clear of PCB x=40.0)
      x_wall_o = cav[2] + wall;                       // 41.9
      x_stem_i = x_wall_o + hook_stem_clr;            // 42.1
      x_stem_o = x_stem_i + hook_stem_t;              // 43.2
      z_sk     = z_split + 0.15;                      // 7.75
      z_fl     = z_sk + (x_stem_o - x_wall_o);        // 9.05 (45-deg flare)
      for (h = hooks)
        translate([0, h[1] - hook_clr, 0]) rotate([90, 0, 0])
          linear_extrude(h[1] - h[0] - 2*hook_clr)
            polygon([[x_catch,  hook_z0],
                     [x_stem_o, hook_z0],
                     [x_stem_o, z_sk],
                     [x_wall_o, z_fl],
                     [cav[2],   z_fl],
                     [cav[2],   z_sk],
                     [x_stem_i, z_sk],
                     [x_stem_i, hook_z1],
                     [x_catch,  hook_chamfer_z]]);
      // solid plastic clamp posts on board top: H1 (no metal near 3V3 track) and beside H2 (clears right wall at +1.4 X)
      translate([h1[0], h1[1], z_bt]) cylinder(d = post_d, h = z_ceil - z_bt + 0.01);
      translate([h2_post_pos[0], h2_post_pos[1], z_bt]) cylinder(d = h2_post_d, h = z_ceil - z_bt + 0.01);
      // external side-ear lugs for M3 x 8 mm SHCS (clear of base half-lap tongue and inner cavity)
      difference() {
        for (p = lugs) hull() {
          translate([p[0], p[1], z_split]) cylinder(d = lug_d, h = z_top - z_split);
          translate([p[0] < 0 ? cav[0] - wall/2 : cav[2] + wall/2, p[1], z_split]) cylinder(d = lug_d, h = z_top - z_split);
        }
        rbox(cav, r_in, z_split - 1, z_top + 1);
        rbox(grow(cav, wall/2 + lap_clr/2), r_in + wall/2 + lap_clr/2, z_split - 0.1, z_split + lap_h + lap_clr);
      }
      // HDMI backing rib behind the housing, tied into the left skirt
      box(cav[0], hdmi_rear_y - rib_gap - rib_t, z_bt + rib_clear, hdmi_x1, hdmi_rear_y - rib_gap, z_ceil + 0.01);
      // gussets from the rib to the top plate (toward the board centre)
      for (x = [4, 10, 16]) hull() {
        box(x - 0.6, hdmi_rear_y - rib_gap - rib_t - 0.01, z_ceil - 0.01, x + 0.6, hdmi_rear_y - rib_gap - rib_t, z_ceil);
        box(x - 0.6, hdmi_rear_y - rib_gap - rib_t - 3, z_ceil - 0.01, x + 0.6, hdmi_rear_y - rib_gap - rib_t, z_ceil);
        box(x - 0.6, hdmi_rear_y - rib_gap - rib_t - 0.01, z_ceil - 2.5, x + 0.6, hdmi_rear_y - rib_gap - rib_t, z_ceil);
      }
      // press pad on the HDMI top if something else is taller than it
      if (z_ceil > z_bt + hdmi_h + hdmi_top_gap + 0.01)
        box(hdmi_x0 + 0.5, hdmi_rear_y + 0.5, z_bt + hdmi_h + hdmi_top_gap, hdmi_x1 - 0.5, hdmi_face_y - 0.5, z_ceil + 0.01);
      // separate tubes per aperture (D2 and U4 must not share a cavity)
      for (a = apertures) translate([a[0], a[1], z_bt + a[3]])
        cylinder(d = a[2] + 2*tube_wall, h = z_ceil - z_bt - a[3] + 0.01);
    }
    openings();
    for (a = apertures) translate([a[0], a[1], z_bt + a[3] - 1]) cylinder(d = a[2], h = z_top - z_bt);
    for (s = [sw1, sw2]) translate([s[0], s[1], z_top - pin_recess]) cylinder(d = pin_recess_d, h = pin_recess + 1);
    if (d2_window_recess > 0)
      translate([apertures[0][0], apertures[0][1], z_top - d2_window_recess]) cylinder(d = d2_window_d, h = 2);
    // M3 x 8 mm SHCS clearance + cap-head counterbore from above in side lugs
    for (p = lugs) translate([p[0], p[1], 0]) {
      translate([0, 0, z_split - 1]) cylinder(d = screw_clear_d, h = z_top - z_split + 2);
      translate([0, 0, z_top - head_cbore]) cylinder(d = head_d, h = head_cbore + 1);
    }
    // engraved marks on the top
    translate([jst_plus[0], jst_plus[1], z_top - mark_depth]) linear_extrude(1) mtext("+", 4);
    translate([sw1[0], sw1[1] + 4.2, z_top - mark_depth]) linear_extrude(1) mtext("R", 2.5);
    translate([sw2[0], sw2[1] + 4.2, z_top - mark_depth]) linear_extrude(1) mtext("B", 2.5);
  }
}

// ---------------- board ghost + keep-outs ----------------
module unmodelled_keepouts() {   // board coords, absolute z
  color("orange", 0.8) box(hdmi_x0, hdmi_rear_y, z_bt, hdmi_x1, hdmi_face_y, z_bt + hdmi_h);       // J2 (corrected)
  color("orange", 0.8) box(4.5, hdmi_lead_y0, z_bt, 15.5, hdmi_rear_y, z_bt + 0.2);                 // J2 leads
  color("orange", 0.8) for (s = hdmi_slots) box(s[0]-0.45, s[1], z_bb - hdmi_leg, s[0]+0.45, s[2], z_bb); // J2 legs
  color("magenta", 0.8) box(usb_cx - usb_w/2, usb_y0, z_bt, usb_cx + usb_w/2, usb_y1, z_bt + usb_h);    // J1
  color("magenta", 0.8) box(jst_x0, jst_cy - jst_w/2, z_bt, jst_mouth_x, jst_cy + jst_w/2, z_bt + jst_h); // J3
  color("cyan", 0.8) for (s = [sw1, sw2]) box(s[0]-sw_size/2, s[1]-sw_size/2, z_bt, s[0]+sw_size/2, s[1]+sw_size/2, z_bt + sw_h);
}
module stl_keepout_boxes()
  color("yellowgreen", 0.6) for (k = stl_keepouts) box(k[0], k[2], z_bt, k[1], k[3], z_bt + max(k[4], 0.05));
module board_slab() color("darkgreen", 0.9) difference() {
  rbox([0, 0, board_w, board_l], board_r, z_bb, z_bt);
  for (p = [h1, h2]) translate([p[0], p[1], z_bb - 0.5]) cylinder(d = 2.2, h = board_t + 1);
}
module all_keepouts() { unmodelled_keepouts(); stl_keepout_boxes(); }
module ghost() { if (show_ghost) %translate([0, 0, z_bb]) import(ghost_stl); }   // already model frame

// ---------------- parts ----------------
// 0.001 mm^3 reference voxel keeps check exports non-empty (openscad exits 0) without masking >= 0.01 mm^3 overlaps
module check_wrap() { union() { translate([-50, -50, 0]) cube(0.1); children(); } }

if (part == "base") to_model() base();
else if (part == "lid") to_model() lid();
else if (part == "base_print") to_model() base();
else if (part == "lid_print") rotate([180, 0, 0]) translate([0, 0, -z_top]) to_model() lid();
else if (part == "lid_keepout_check") to_model() check_wrap() intersection() { lid(); union() { all_keepouts(); board_slab(); } }
else if (part == "base_keepout_check") to_model() check_wrap() intersection() { base(); union() { all_keepouts(); board_slab(); } }
else if (part == "base_lid_overlap_check") to_model() check_wrap() intersection() { base(); translate([lid_x_shift, 0, lid_z_shift]) lid(); }
else if (part == "insertion_check") to_model() check_wrap() intersection() { translate([lid_x_shift, 0, lid_z_shift]) lid(); union() { base(); board_slab(); all_keepouts(); } }
else if (part == "section_hook") {    // cut at y = 9 through upper right-side hook tab & base lintel
  to_model() intersection() {
    union() { color("SteelBlue") base(); color("LightSteelBlue") lid(); stl_keepout_boxes(); board_slab(); }
    box(25, -5, -1, 50, 9.0, 20);
  }
}
else if (part == "test_hook_base") to_model() intersection() { base(); box(38.5, 4, -1, 46, 15, 20); }
else if (part == "test_hook_lid")  rotate([180, 0, 0]) translate([0, 0, -z_top]) to_model() intersection() { lid(); box(38.5, 4, -1, 46, 15, 20); }
else if (part == "test_h2_hook_base") to_model() intersection() { base(); box(33.5, 27, -1, 46, 42, 20); }
else if (part == "test_h2_hook_lid")  rotate([180, 0, 0]) translate([0, 0, -z_top]) to_model() intersection() { lid(); box(33.5, 27, -1, 46, 42, 20); }
else if (part == "assembly") {
  to_model() {
    color("SteelBlue") base();
    translate([0, 0, lid_lift]) color("LightSteelBlue", 0.45) lid();
    if (show_keepouts) unmodelled_keepouts();
  }
  ghost();
}
else if (part == "section_hdmi") {   // cut at x = hdmi_cx, keep x <= cut; view from +X
  to_model() intersection() {
    union() { color("SteelBlue") base(); color("LightSteelBlue") lid(); unmodelled_keepouts(); stl_keepout_boxes(); board_slab(); }
    box(-10, -20, -1, hdmi_cx, 60, 30);
  }
  %translate([0, 0, z_bb]) import("previews/ghost_x_le_10.stl");
}
else if (part == "section_antenna") {  // cut at x = 14 through the antenna; view from +X
  to_model() intersection() {
    union() { color("SteelBlue") base(); color("LightSteelBlue") lid(); stl_keepout_boxes(); board_slab(); unmodelled_keepouts(); }
    box(-10, -20, -1, 14, 60, 30);
  }
  %translate([0, 0, z_bb]) import("previews/ghost_x_le_14.stl");
}
else if (part == "top_antenna") {     // base + board from above, metal keep-out zone in red
  to_model() {
    color("SteelBlue") base();
    color("red", 0.35) translate([0, 0, z_top]) linear_extrude(0.2)
      offset(r = ant_metal_keepout) translate([ant_x0, -ant_overhang]) square([ant_x1 - ant_x0, ant_overhang]);
    color("gold") for (p = lugs) translate([p[0], p[1], 0]) cylinder(d = head_d, h = z_top + 0.5);
    color("gold") for (k = keyholes) translate([k[0], k[1] - kh_slot_l, 0]) cylinder(d = kh_head_d, h = z_top + 0.5);
    color("white") translate([ant_x0, -ant_overhang, z_bt]) cube([ant_x1 - ant_x0, ant_overhang, ant_h]);
  }
  ghost();
}
